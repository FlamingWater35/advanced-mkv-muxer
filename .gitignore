# Keep the repository's own build helpers: /Scripts (virtualenv) is matched
# case-insensitively on Windows and would otherwise hide /scripts as well.
!/scripts/
/venv/
/.venv/
/pyvenv.cfg
/.idea/
/MkvEnv/
/MkvEnv32/
/build/
/dist/
/.scratch/
# Local scratch space used by agent runs and ad-hoc probes, plus the report
# folder of the Windows sandbox ACL diagnostic. Neither is part of the project.
/.work/
/.acl-recovery/
/Testing/test.py
/Testing/
*.pyc
__pycache__/
/tests/.tmp/
test.py
